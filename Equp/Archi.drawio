        <mxCell id="sec1" value="1  DATA INGESTION (WEB CRAWLING &amp; MONITORING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E0FF;strokeColor=#8B6FD8;fontStyle=1;fontSize=18;fontColor=#25205A;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
