        </mxCell>
        <mxCell id="crawler" value="&lt;b&gt;Web Crawler&lt;/b&gt;&lt;br&gt;(Playwright)&lt;br&gt;&lt;br&gt;• Same-domain crawling&lt;br&gt;• Follow links&lt;br&gt;• Respect robots.txt&lt;br&gt;• Handle JavaScript pages&lt;br&gt;• Detect PDFs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6FF;strokeColor=#7957C7;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
