        </mxCell>
        <mxCell id="hash" value="&lt;b&gt;Change Detection&lt;/b&gt;&lt;br&gt;(SHA-256 Hash)&lt;br&gt;&lt;br&gt;• New URL → NEW&lt;br&gt;• Same hash → UNCHANGED&lt;br&gt;• Different hash → UPDATED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE7EC;strokeColor=#D84E65;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
