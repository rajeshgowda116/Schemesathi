        </mxCell>
        <mxCell id="sources" value="&lt;b&gt;Official Government Sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;gov.in&lt;br&gt;myScheme&lt;br&gt;&lt;br&gt;• Ministry Websites&lt;br&gt;• State Portals&lt;br&gt;• Scheme Pages&lt;br&gt;• Notifications&lt;br&gt;• PDFs&lt;br&gt;• Policy Documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;fontSize=13;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="170" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="scheduler" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;(Every 12 hours)&lt;br&gt;&lt;br&gt;APScheduler / Cron" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF1FF;strokeColor=#4B9BE8;fontSize=13;" vertex="1" parent="1">
