        </mxCell>
        <mxCell id="webtext" value="&lt;b&gt;Web Pages&lt;/b&gt;&lt;br&gt;(HTML → Text)&lt;br&gt;&lt;br&gt;• Extract visible text&lt;br&gt;• Remove noise&lt;br&gt;• Keep clean content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F8E9;strokeColor=#69B77B;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="170" height="130" as="geometry"/>
        </mxCell>
